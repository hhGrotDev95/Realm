// Generates migrations/0006_seed_demo_festivals.sql from the app's built-in demo data
// plus a second, deliberately different festival to prove tenant isolation.
// Run: node --experimental-strip-types scripts/build-seed.mts
import { writeFileSync } from 'node:fs'
import { ACTS, DAYS, POIS, STAGES } from '../../src/data.ts'

const q = (v: unknown) => (v === null || v === undefined ? 'NULL' : typeof v === 'number' ? String(v) : `'${String(v).replace(/'/g, "''")}'`)
const rows: string[] = []
const ins = (table: string, obj: Record<string, unknown>) => rows.push(`INSERT INTO ${table} (${Object.keys(obj).join(', ')}) VALUES (${Object.values(obj).map(q).join(', ')});`)

// Festival 1: Realm Open Air (exists since 0005) – stages, days, acts, pois
STAGES.forEach((s, i) => ins('stages', { festival_id: 'realm', id: s.id, name: s.name, color: s.color, x: s.x, y: s.y, vibe: s.vibe, sort: i }))
DAYS.forEach((d) => ins('festival_days', { festival_id: 'realm', idx: d.idx, date: d.date, label: d.label, short: d.short }))
ACTS.forEach((a) => ins('acts', { festival_id: 'realm', id: a.id, day: a.day, stage_id: a.stage, artist: a.artist, start_min: a.start, end_min: a.end, genre: a.genre, bio: a.bio, popularity: Math.round(a.popularity * 1000) / 1000 }))
POIS.forEach((p) => ins('pois', { festival_id: 'realm', id: p.id, cat: p.cat, name: p.name, x: p.x, y: p.y, detail: p.detail, status: p.status ?? null, important: p.important ? 1 : 0 }))

// Festival 2: Nordlicht Sessions – small, different ids and names on purpose,
// but also an act id ("1-maduk") that collides with festival 1 to test isolation.
ins('festivals', { id: 'nordlicht', slug: 'nordlicht', name: 'Nordlicht Sessions', location: 'Flensburg Hafen', status: 'published', theme: JSON.stringify({ brand: '#4FD1C5' }), modules: '{}', created_at: 0, updated_at: 0 })
;[
  { id: 'pier', name: 'Pier', color: '#4FD1C5', x: 300, y: 300, vibe: 'Electronic · Waterfront' },
  { id: 'werft', name: 'Werft', color: '#F6AD55', x: 650, y: 520, vibe: 'Live · Indie' },
].forEach((s, i) => ins('stages', { festival_id: 'nordlicht', ...s, sort: i }))
;[
  { idx: 0, date: '2027-08-20', label: 'Freitag', short: 'Fr' },
  { idx: 1, date: '2027-08-21', label: 'Samstag', short: 'Sa' },
].forEach((d) => ins('festival_days', { festival_id: 'nordlicht', ...d }))
;[
  ['0-tidewater', 0, 'pier', 'Tidewater', 1140, 1230, 'Deep House'],
  ['0-salt-and-sails', 0, 'werft', 'Salt & Sails', 1170, 1245, 'Indie Folk'],
  ['0-harbour-lights', 0, 'pier', 'Harbour Lights', 1260, 1380, 'Melodic Techno'],
  ['1-maduk', 1, 'werft', 'Fjordkind', 1200, 1290, 'Post-Rock'],
  ['1-north-signal', 1, 'pier', 'North Signal', 1320, 1440, 'Techno'],
].forEach(([id, day, stage, artist, s, e, genre]) =>
  ins('acts', { festival_id: 'nordlicht', id, day, stage_id: stage, artist, start_min: s, end_min: e, genre, bio: '', popularity: 0.5 }),
)
;[
  { id: 'stage-pier', cat: 'stage', name: 'Pier', x: 300, y: 300, detail: 'Electronic · Waterfront', important: 1 },
  { id: 'stage-werft', cat: 'stage', name: 'Werft', x: 650, y: 520, detail: 'Live · Indie', important: 1 },
  { id: 'w1', cat: 'water', name: 'Wasser am Kai', x: 480, y: 380, detail: 'Trinkwasser', status: 'open', important: 1 },
  { id: 'en1', cat: 'entrance', name: 'Eingang Hafenspitze', x: 120, y: 120, detail: 'Tickets & Bändchen', status: 'open', important: 1 },
].forEach((p) => ins('pois', { festival_id: 'nordlicht', status: null, ...p }))

writeFileSync(
  new URL('../migrations/0006_seed_demo_festivals.sql', import.meta.url),
  `-- Generated by scripts/build-seed.mts – do not edit by hand.\n-- Demo data for two festivals; real festivals are created through the admin console.\n${rows.join('\n')}\n`,
)
console.log(`${rows.length} rows written`)
