{
  "name": "realm-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "migrate:local": "wrangler d1 migrations apply realm --local",
    "migrate:remote": "wrangler d1 migrations apply realm --remote",
    "deploy": "wrangler deploy",
    "dev:staging": "wrangler dev --env staging --local --port 8790",
    "migrate:staging:local": "wrangler d1 migrations apply realm-staging --env staging --local",
    "migrate:staging": "wrangler d1 migrations apply realm-staging --env staging --remote",
    "deploy:staging": "wrangler deploy --env staging --upload-source-maps=false",
    "typecheck": "tsc -p .",
    "test": "node test/api.test.mjs && node test/migration.test.mjs",
    "announce": "node scripts/announce.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
